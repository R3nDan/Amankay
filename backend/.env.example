# Plantilla de referencia. Spring Boot no carga este archivo automáticamente.
# Configura estos valores en el entorno del proceso antes de iniciar la aplicación.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_SSL_MODE=disable

# Defaults are local-only; Render sets these explicitly for its public service.
